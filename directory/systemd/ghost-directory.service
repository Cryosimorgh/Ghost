[Unit]
Description=Ghost volatile rendezvous directory (NOT a message relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ghostdir
Group=ghostdir
WorkingDirectory=/opt/ghost-directory
ExecStart=/opt/ghost-directory/.venv/bin/python /opt/ghost-directory/ghost_directory.py --bind 0.0.0.0 --publish-port 47801 --lookup-port 47802 --max-memory-mb 16
Restart=always
RestartSec=3
MemoryMax=128M
TasksMax=128
LimitNOFILE=1024
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
